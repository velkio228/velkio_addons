<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="payment_method_cash" model="pos.screen.payment.method">
            <field name="name">Cash</field>
            <field name="payment_type">cash</field>
            <field name="sequence">1</field>
            <field name="machine_name">Counter Drawer</field>
        </record>

        <record id="payment_method_card" model="pos.screen.payment.method">
            <field name="name">Card</field>
            <field name="payment_type">card</field>
            <field name="sequence">2</field>
        </record>

        <record id="payment_method_upi" model="pos.screen.payment.method">
            <field name="name">UPI</field>
            <field name="payment_type">upi</field>
            <field name="sequence">3</field>
        </record>

        <record id="payment_method_credit" model="pos.screen.payment.method">
            <field name="name">Credit</field>
            <field name="payment_type">credit</field>
            <field name="sequence">4</field>
        </record>

        <!-- Default counter. Stock locations are left empty on purpose: the
             delivery-on-payment constraint would otherwise fail on databases
             that have no warehouse yet. Set them in Configuration > Counters. -->
        <record id="config_main_counter" model="pos.screen.config">
            <field name="name">Main Counter</field>
            <field name="sequence">1</field>
            <field name="deliver_on_payment" eval="False"/>
            <field name="payment_method_ids"
                   eval="[(6, 0, [ref('payment_method_cash'),
                                  ref('payment_method_card'),
                                  ref('payment_method_upi'),
                                  ref('payment_method_credit')])]"/>
        </record>

    </data>
</odoo>

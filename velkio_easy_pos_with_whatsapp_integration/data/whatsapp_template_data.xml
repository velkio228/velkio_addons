<?xml version="1.0"?>
<odoo noupdate="1">
    <!--
        Starts as a draft on purpose. Meta only delivers business initiated
        messages through a template IT has approved, so this must be submitted
        from WhatsApp > Templates and approved before any bill can be sent.
    -->
    <record id="whatsapp_template_pos_screen_bill" model="whatsapp.template"
            forcecreate="0">
        <field name="name">POS Bill</field>
        <field name="template_name">pos_screen_bill</field>
        <field name="lang_code">en</field>
        <field name="template_type">utility</field>
        <field name="header_type">document</field>
        <field name="report_id" ref="velkio_easy_pos_with_whatsapp_integration.action_report_pos_screen_order"/>
        <field name="footer_text">Write 'stop' to stop receiving messages</field>
        <field name="phone_field">partner_id.mobile</field>
        <field name="model_id" ref="velkio_easy_pos_with_whatsapp_integration.model_pos_screen_order"/>
        <field name="body">Hello {{1}},

Thank you for shopping at *{{2}}*.

Your bill *{{3}}* is attached, for a total of *{{4}} {{5}}*.

Please keep it for any exchange or warranty claim.</field>
        <field name="variable_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'name': '{{1}}',
                'demo_value': 'Ravi Traders',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'partner_id',
            }),
            (0, 0, {
                'name': '{{2}}',
                'demo_value': 'My Company',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'company_id',
            }),
            (0, 0, {
                'name': '{{3}}',
                'demo_value': 'POS/2026/00001',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'name',
            }),
            (0, 0, {
                'name': '{{4}}',
                'demo_value': 'INR',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'currency_id.name',
            }),
            (0, 0, {
                'name': '{{5}}',
                'demo_value': '362.48',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'amount_total',
            }),
        ]"/>
    </record>
</odoo>

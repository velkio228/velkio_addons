<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock on hand, scoped to what the counters actually sell -->
    <record id="action_pos_screen_stock_quant" model="ir.actions.act_window">
        <field name="name">Stock on Hand</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="context">{'search_default_internal_loc': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock to show</p>
            <p>Quantities available in your internal locations.</p>
        </field>
    </record>

    <!-- Deliveries generated by paid bills -->
    <record id="action_pos_screen_picking" model="ir.actions.act_window">
        <field name="name">POS Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('pos_screen_order_ids', '!=', False)]</field>
        <field name="context">{'contact_display': 'partner_address'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS delivery yet</p>
            <p>Deliveries created when a bill is paid appear here.</p>
        </field>
    </record>

    <record id="action_pos_screen_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('sale_ok', '=', True)]</field>
        <field name="context">{'default_sale_ok': 1}</field>
    </record>

    <record id="action_pos_screen_move" model="ir.actions.act_window">
        <field name="name">Stock Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_id.pos_screen_order_ids', '!=', False)]</field>
    </record>

</odoo>

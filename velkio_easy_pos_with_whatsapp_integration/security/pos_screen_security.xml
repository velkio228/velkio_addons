<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_pos_screen" model="ir.module.category">
        <field name="name">Velkio Easy POS</field>
        <field name="description">Access rights for the POS billing screen</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_pos_screen_user" model="res.groups">
        <field name="name">Cashier</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="category_id" ref="module_category_pos_screen"/>
        <field name="comment">Can bill from the POS screen and manage own orders.</field>
    </record>

    <record id="group_pos_screen_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_pos_screen"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_screen_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to every POS screen order.</field>
    </record>

    <record id="pos_screen_order_company_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Order: multi-company</field>
        <field name="model_id" ref="model_pos_screen_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="pos_screen_order_line_company_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Order Line: multi-company</field>
        <field name="model_id" ref="model_pos_screen_order_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="pos_screen_order_own_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Order: own orders</field>
        <field name="model_id" ref="model_pos_screen_order"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pos_screen_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pos_screen_order_all_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Order: all orders</field>
        <field name="model_id" ref="model_pos_screen_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pos_screen_manager'))]"/>
    </record>

    <record id="pos_screen_config_company_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Counter: multi-company</field>
        <field name="model_id" ref="model_pos_screen_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="pos_screen_payment_method_company_rule" model="ir.rule">
        <field name="name">Velkio Easy POS Payment Method: multi-company</field>
        <field name="model_id" ref="model_pos_screen_payment_method"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

<record id="line_own_rule" model="ir.rule"><field name="name">Velkio line_own</field><field name="model_id" ref="model_pos_screen_order_line"/><field name="domain_force">[('order_id.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_pos_screen_user'))]"/></record>
<record id="line_all_rule" model="ir.rule"><field name="name">Velkio line_all</field><field name="model_id" ref="model_pos_screen_order_line"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('group_pos_screen_manager'))]"/></record>
<record id="column_company_rule" model="ir.rule"><field name="name">Velkio column_company</field><field name="model_id" ref="model_pos_screen_config_field"/><field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
</odoo>

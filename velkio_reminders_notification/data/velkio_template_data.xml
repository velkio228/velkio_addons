<!-- Personal -->
<record id="tpl_break" model="velkio.template">
    <field name="name">Take a break</field>
    <field name="category">personal</field>
    <field name="sequence">1</field>
    <field name="title">Time for a break</field>
    <field name="body" type="html"><p>Step away from the screen for a few minutes. Stretch, drink some water.</p></field>
    <field name="level">info</field>
    <field name="duration">20</field>
    <field name="lead_minutes">60</field>
    <field name="color">4</field>
</record>

<record id="tpl_callback" model="velkio.template">
    <field name="name">Call someone back</field>
    <field name="category">personal</field>
    <field name="sequence">2</field>
    <field name="title">Call back</field>
    <field name="body" type="html"><p>You said you would call back about this. Now is the time.</p></field>
    <field name="level">info</field>
    <field name="duration">30</field>
    <field name="lead_minutes">30</field>
    <field name="color">4</field>
</record>

<record id="tpl_followup" model="velkio.template">
    <field name="name">Follow up on a request</field>
    <field name="category">personal</field>
    <field name="sequence">3</field>
    <field name="title">Follow up</field>
    <field name="body" type="html"><p>No reply yet. Send a gentle nudge or pick up the phone.</p></field>
    <field name="level">info</field>
    <field name="duration">30</field>
    <field name="lead_minutes">1440</field>
    <field name="color">4</field>
</record>

<record id="tpl_end_of_day" model="velkio.template">
    <field name="name">Wrap up the day</field>
    <field name="category">personal</field>
    <field name="sequence">4</field>
    <field name="title">Wrap up for today</field>
    <field name="body" type="html"><p>Save your work, note where you stopped, and log your hours.</p></field>
    <field name="level">info</field>
    <field name="duration">40</field>
    <field name="lead_minutes">480</field>
    <field name="color">4</field>
</record>


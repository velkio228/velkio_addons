<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════
     POPUP STYLE
══════════════════════════════════════════════════ -->
<record id="velkio_popup_style_form_view" model="ir.ui.view">
    <field name="name">velkio.popup.style.form</field>
    <field name="model">velkio.popup.style</field>
    <field name="arch" type="xml">
        <form string="Popup Style" class="velkio-view velkio-style-form">
            <header>
                <button name="action_preview" type="object" string="Preview on My Screen"
                        class="btn-primary" icon="fa-eye"/>
            </header>
            <sheet>
                <widget name="web_ribbon" title="Default" bg_color="text-bg-success"
                        invisible="not is_default"/>
                <div class="oe_title">
                    <label class="o_form_label" for="name"/>
                    <h1><field name="name" placeholder="e.g. Company house style"/></h1>
                </div>
                <group>
                    <group string="Start From">
                        <field name="preset"/>
                        <field name="skin"/>
                        <field name="is_default"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Where It Appears">
                        <field name="position"/>
                        <field name="width"/>
                        <field name="stack_limit"/>
                    </group>
                </group>
                <group>
                    <group string="Look">
                        <field name="appearance"/>
                        <field name="surface"/>
                        <field name="radius"/>
                        <field name="shadow"/>
                    </group>
                    <group string="Motion">
                        <field name="animation"/>
                        <field name="compact"/>
                    </group>
                </group>
                <group>
                    <group string="Colour">
                        <field name="accent_mode" widget="radio"/>
                        <field name="accent_color" widget="color"
                               invisible="accent_mode != 'custom'"/>
                        <field name="color_info" widget="color"
                               invisible="accent_mode != 'level'"/>
                        <field name="color_warning" widget="color"
                               invisible="accent_mode != 'level'"/>
                        <field name="color_urgent" widget="color"
                               invisible="accent_mode != 'level'"/>
                    </group>
                    <group string="Show On The Popup">
                        <field name="show_icon"/>
                        <field name="show_level_chip"/>
                        <field name="show_author"/>
                        <field name="show_progress"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Use <b>Preview on My Screen</b> to see the result straight away.
                    Changes apply to the next popup — nothing needs rebuilding.
                </div>
            </sheet>
        </form>
    </field>
</record>

<record id="velkio_popup_style_tree_view" model="ir.ui.view">
    <field name="name">velkio.popup.style.tree</field>
    <field name="model">velkio.popup.style</field>
    <field name="arch" type="xml">
        <tree string="Popup Styles" class="velkio-list" decoration-bf="is_default">
            <field name="name"/>
            <field name="preset"/>
            <field name="skin"/>
            <field name="position"/>
            <field name="appearance"/>
            <field name="surface"/>
            <field name="animation"/>
            <field name="is_default"/>
            <button name="action_preview" type="object" string="Preview" icon="fa-eye"/>
        </tree>
    </field>
</record>

<record id="action_velkio_popup_styles" model="ir.actions.act_window">
    <field name="name">Popup Styles</field>
    <field name="res_model">velkio.popup.style</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Design your popup
        </p>
        <p>Choose where notifications appear, how they look and how they move.
           One style is the default; a notification may also pick its own.</p>
    </field>
</record>

<!-- ══════════════════════════════════════════════════
     TEMPLATES
══════════════════════════════════════════════════ -->
<record id="velkio_template_kanban_view" model="ir.ui.view">
    <field name="name">velkio.template.kanban</field>
    <field name="model">velkio.template</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column velkio-kanban" sample="1">
            <field name="name"/>
            <field name="category"/>
            <field name="level"/>
            <field name="usage_count"/>
            <field name="color"/>
            <templates>
                <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_global_click oe_kanban_card #{kanban_color(record.color.raw_value)}">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="category"/> · <field name="level"/>
                                </small>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="title"/>
                        </div>
                        <div class="o_kanban_record_bottom mt-2">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge text-bg-light">
                                    Used <t t-esc="record.usage_count.value"/>×
                                </span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <button name="action_use" type="object"
                                        class="btn btn-primary btn-sm">Use</button>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<record id="velkio_template_tree_view" model="ir.ui.view">
    <field name="name">velkio.template.tree</field>
    <field name="model">velkio.template</field>
    <field name="arch" type="xml">
        <tree string="Templates" class="velkio-list">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="category"/>
            <field name="title"/>
            <field name="level"/>
            <field name="duration"/>
            <field name="require_ack"/>
            <field name="usage_count"/>
            <button name="action_use" type="object" string="Use" icon="fa-plus-circle"/>
        </tree>
    </field>
</record>

<record id="velkio_template_form_view" model="ir.ui.view">
    <field name="name">velkio.template.form</field>
    <field name="model">velkio.template</field>
    <field name="arch" type="xml">
        <form string="Template" class="velkio-view">
            <header>
                <button name="action_use" type="object" class="btn-primary"
                        string="Use This Template"/>
            </header>
            <sheet>
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
                <div class="oe_title">
                    <label class="o_form_label" for="name"/>
                    <h1><field name="name" placeholder="Template name"/></h1>
                </div>
                <group>
                    <group string="Classification">
                        <field name="category"/>
                        <field name="level"/>
                        <field name="color" widget="color_picker"/>
                        <field name="usage_count"/>
                        <field name="active" invisible="1"/>
                        <field name="sequence" invisible="1"/>
                    </group>
                    <group string="Popup Defaults">
                        <field name="duration"/>
                        <field name="require_ack"/>
                        <field name="allow_snooze"/>
                        <field name="play_sound"/>
                        <field name="lead_minutes"/>
                    </group>
                </group>
                <group string="Popup Title">
                    <field name="title" nolabel="1"/>
                </group>
                <group string="Message">
                    <field name="body" nolabel="1"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="velkio_template_search_view" model="ir.ui.view">
    <field name="name">velkio.template.search</field>
    <field name="model">velkio.template</field>
    <field name="arch" type="xml">
        <search string="Search Templates">
            <field name="name"/>
            <field name="title"/>
            <field name="body"/>
            <filter string="Urgent" name="urgent" domain="[('level', '=', 'urgent')]"/>
            <filter string="Needs Acknowledgement" name="ack"
                    domain="[('require_ack', '=', True)]"/>
            <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            <group expand="0" string="Group By">
                <filter string="Category" name="by_category" context="{'group_by': 'category'}"/>
                <filter string="Level" name="by_level" context="{'group_by': 'level'}"/>
            </group>
        </search>
    </field>
</record>

<record id="action_velkio_templates" model="ir.actions.act_window">
    <field name="name">Templates</field>
    <field name="res_model">velkio.template</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="search_view_id" ref="velkio_template_search_view"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Ready-made notices
        </p>
        <p>Pick one, set the time, send it. You can edit these freely or add
           your own.</p>
    </field>
</record>

<!-- ══════════════════════════════════════════════════
     DASHBOARD
══════════════════════════════════════════════════ -->
<record id="action_velkio_dashboard" model="ir.actions.client">
    <field name="name">Reminders Dashboard</field>
    <field name="tag">velkio_dashboard</field>
</record>

</data>
</odoo>

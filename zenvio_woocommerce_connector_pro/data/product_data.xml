<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_woo_shipping" model="product.product">
        <field name="name">WooCommerce Shipping</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>

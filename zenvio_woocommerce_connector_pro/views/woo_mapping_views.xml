<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_variant_mapping_list" model="ir.ui.view">
        <field name="name">woo.variant.mapping.list</field>
        <field name="model">woo.variant.mapping</field>
        <field name="arch" type="xml">
            <list string="Variation Mappings">
                <field name="instance_id"/>
                <field name="woo_parent_id"/>
                <field name="woo_id"/>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="woo_stock_qty"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_woo_variant_mapping_form" model="ir.ui.view">
        <field name="name">woo.variant.mapping.form</field>
        <field name="model">woo.variant.mapping</field>
        <field name="arch" type="xml">
            <form string="Variation Mapping">
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="woo_parent_id"/>
                        <field name="woo_id"/>
                        <field name="sku"/>
                        <field name="product_id"/>
                        <field name="woo_stock_qty"/>
                        <field name="last_sync_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_variant_mapping" model="ir.actions.act_window">
        <field name="name">Variation Mappings</field>
        <field name="res_model">woo.variant.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_woo_tax_mapping_list" model="ir.ui.view">
        <field name="name">woo.tax.mapping.list</field>
        <field name="model">woo.tax.mapping</field>
        <field name="arch" type="xml">
            <list string="Tax Rate Mappings" editable="bottom">
                <field name="instance_id"/>
                <field name="company_id" column_invisible="True"/>
                <field name="woo_id"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="tax_id" decoration-danger="not tax_id"/>
            </list>
        </field>
    </record>

    <record id="action_woo_tax_mapping" model="ir.actions.act_window">
        <field name="name">Tax Rate Mappings</field>
        <field name="res_model">woo.tax.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WooCommerce tax rates yet</p>
            <p>Open an instance and use Import Tax Rates, then choose the Odoo tax for each rate.</p>
        </field>
    </record>

    <record id="view_woo_product_mapping_list_pro" model="ir.ui.view">
        <field name="name">woo.product.mapping.list.pro</field>
        <field name="model">woo.product.mapping</field>
        <field name="inherit_id" ref="zenvio_woocommerce_connector.view_woo_product_mapping_list"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="woo_stock_qty" optional="show"/>
            </field>
        </field>
    </record>
</odoo>

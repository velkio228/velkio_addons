<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zenvio_department_login_log_list" model="ir.ui.view">
        <field name="name">zenvio.department.login.log.list</field>
        <field name="model">zenvio.department.login.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="result == 'failed'">
                <field name="login_date"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="login_code"/>
                <field name="ip_address"/>
                <field name="result"/>
                <field name="switched_by_id" optional="show"/>
                <field name="switched_by_employee_id" optional="show"/>
                <field name="user_agent" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zenvio_department_login_log_search" model="ir.ui.view">
        <field name="name">zenvio.department.login.log.search</field>
        <field name="model">zenvio.department.login.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="login_code"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                <filter name="today" string="Today" domain="[('login_date', '&gt;=', 'today')]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zenvio_department_login_log" model="ir.actions.act_window">
        <field name="name">Login Log</field>
        <field name="res_model">zenvio.department.login.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

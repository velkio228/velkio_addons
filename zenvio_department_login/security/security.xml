<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_department_manager" model="res.groups">
        <field name="name">Department Access: Top Management</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Given by turning on Top Management on the user's Department Access tab.</field>
    </record>

    <!-- A Top Management user sees only its own departments; the administrator sees all of them. -->
    <record id="rule_department_access_owner" model="ir.rule">
        <field name="name">Department Access: own departments</field>
        <field name="model_id" ref="model_zenvio_department_access"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_department_manager'))]"/>
    </record>
    <record id="rule_department_access_admin" model="ir.rule">
        <field name="name">Department Access: administrator sees all</field>
        <field name="model_id" ref="model_zenvio_department_access"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_department_employee_owner" model="ir.rule">

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="velkio_dock_item_own_rule" model="ir.rule">
        <field name="name">Velkio Dock: own items only</field>
        <field name="model_id" ref="model_velkio_dock_item"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Tally Post" buttons on the documents and masters that can be pushed.
         Forms that already own a <header> get the button inside it; the others
         get a header added before their sheet. -->

    <record id="view_move_form_tally_push" model="ir.ui.view">
        <field name="name">account.move.form.tally.push</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tally_post" type="object"
                        string="Tally Post" icon="fa-cloud-upload"
                        invisible="state != 'posted'"
                        groups="velkio_tally_integration.group_tally_user"/>
                <field name="tally_sync_state" widget="badge" string="Tally"
                       decoration-success="tally_sync_state in ('posted', 'from_tally')"
                       decoration-warning="tally_sync_state == 'queued'"
                       decoration-danger="tally_sync_state == 'failed'"
                       decoration-muted="tally_sync_state == 'none'"/>
            </xpath>
        </field>
    </record>

